<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 and 11, so the app needs no runtime install. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CoffeeCup</AssemblyName>
    <RootNamespace>CoffeeCup</RootNamespace>
    <Version>1.0.2</Version>
    <Product>CoffeeCup</Product>
    <Description>Keeps your PC awake. Double-click the mug.</Description>
    <Copyright>Copyright © 2026 droza123</Copyright>
    <ApplicationIcon>..\..\assets\CoffeeCup.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
